<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tiki - Điện Thoại Máy Tính Bảng</title>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <style>
        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f5f5;
            color: #333;
        }



        header {
            background: white;
            border-bottom: 1px solid #ddd;
        }

        .header-top {
            width: 1200px;
            height: 75px;
            margin: auto;

            display: flex;
            align-items: center;
            gap: 25px;
        }
        .search {
            height: 42px;
            flex: 1;

            display: flex;
            align-items: center;

            border: 1px solid #ddd;
            border-radius: 4px;
            overflow: hidden;
        }

        .search i {
            color: #999;
            margin-left: 15px;
        }

        .search input {
            flex: 1;
            height: 100%;

            border: none;
            outline: none;

            padding: 0 15px;

            font-size: 14px;
        }

        .search button {
            width: 100px;
            height: 100%;

            background: white;
            color: #1a94ff;

            border: none;
            border-left: 1px solid #ddd;

            cursor: pointer;
        }

        .search button:hover {
            background: #eef8ff;
        }

        .account {
            display: flex;
            align-items: center;
            gap: 10px;

            color: #555;
            font-size: 13px;
        }

        .account i {
            font-size: 24px;
            color: #555;
        }

        .account small {
            display: block;
            color: #777;
        }


        .cart {
            position: relative;
            color: #1a94ff;
            font-size: 25px;
        }

        .cart span {
            position: absolute;

            top: -8px;
            right: -10px;

            width: 18px;
            height: 18px;

            border-radius: 50%;

            background: red;
            color: white;

            font-size: 10px;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        h1 {
            font-size: 24px;
            margin-bottom: 18px;
        }

        .sidebar-box li i {
            width: 22px;
            color: #777;
        }

        .sidebar-box li:hover {
            color: #1a94ff;
            background: #eef8ff;
        }

        .check {
            display: block;

            margin: 11px 0;

            font-size: 13px;

            color: #555;
        }
    </style>
</head>

<body>

    <header>

        <div class="header-top">

            <div class="logo">
                <h2>TIKI</h2>
                <p>TỐT & NHANH</p>
            </div>

            <div class="search">

                <i class="fas fa-search"></i>

                <input type="text"
                       placeholder="Tìm kiếm sản phẩm, danh mục hay thương hiệu...">

                <button>
                    Tìm kiếm
                </button>

            </div>
</body>
</html>
